PORT=5000
NODE_ENV=development

DATABASE_URL=

# Upstash Redis (REST API) — backs the live cart and unread-notification
# counters. Create a database at https://console.upstash.com and copy these
# from its REST API tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_USER=
EMAIL_PASSWORD=

CLIENT_URL=http://localhost:5173

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard > Settings > Webhooks, when you register
# https://<your-api-domain>/api/v1/payments/webhook and subscribe to the
# payment.captured and payment.failed events.
RAZORPAY_WEBHOOK_SECRET=

# Required to hit POST /app/v1/admin/register — send it back as the
# x-setup-secret header. Keep this out of source control.
ADMIN_SETUP_SECRET=

# Google OAuth ("Sign in with Google" for customers and sellers). Create an
# OAuth client at https://console.cloud.google.com/apis/credentials and add
# these authorized redirect URIs (swap in your real domain in production):
#   http://localhost:5000/app/v1/customer/auth/google/callback
#   http://localhost:5000/app/v1/seller/auth/google/callback
# In production, passport.js uses Render's auto-set RENDER_EXTERNAL_URL for
# the callback base instead of localhost — add that domain's callback URLs
# too once you know it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq (https://console.groq.com/keys) — powers the AI "find the best
# service for my query" search. Free tier; rate-limited per model, which is
# why ai-search.service.js also rate-limits per customer via Redis below
# that.
GROQ_API_KEY=
